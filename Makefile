# MealQuest build entry points.
#
#   make dev     Go server on :8080 plus Vite dev server on :5173 (proxies
#                /api, /auth, /media to :8080). Needs the MEALQUEST_* env set.
#   make test    gofmt check, go vet, go test -race, npm typecheck and test,
#                and the auto-deploy CI gate test (deploy/auto-deploy_test.sh).
#   make build   Build the PWA, embed it, build the static binary bin/mealquest.
#   make docker  Build the container image from ./Dockerfile.
#   make sqlc    Regenerate internal/db from sqlc.yaml with the pinned sqlc.
#   make sqlc-check    Regenerate; fail if internal/db differs from the commit.
#   make sqlc-install  Install the pinned sqlc into the Go bin directory.

FRONTEND_DIST := internal/frontend/dist
# Dirty means a tracked change outside the generated embed output, which
# `make embed` rewrites; plain `--dirty` would flag every rebuild.
GIT_DIRTY := $(shell git status --porcelain --untracked-files=no -- . ':(exclude)$(FRONTEND_DIST)' 2>/dev/null)
VERSION ?= $(shell git describe --tags --always 2>/dev/null || echo dev)$(if $(GIT_DIRTY),-dirty)
IMAGE ?= mealquest:$(VERSION)
LDFLAGS := -s -w -X main.version=$(VERSION)

# sqlc is a dev tool only, never a go.mod dependency. Generated code records
# the version that wrote it, so every run must use exactly this one.
SQLC_VERSION := v1.31.1
SQLC ?= sqlc
SQLC_OUT := internal/db

.PHONY: dev test go-test web-test deploy-test build web embed check-embed-clean docker sqlc sqlc-check sqlc-install

# Run both servers; Ctrl-C (or either exiting) stops both. The binary is built
# first and run directly because `go run` would orphan its child on kill.
dev: SHELL := /bin/bash
dev:
	go build -ldflags "$(LDFLAGS)" -o bin/mealquest-dev ./cmd/server
	@trap 'kill $$(jobs -p) 2>/dev/null; wait' EXIT; \
	bin/mealquest-dev & \
	(cd web && exec npm run dev) & \
	wait -n

test: go-test web-test deploy-test

go-test:
	@unformatted="$$(gofmt -l .)"; \
	if [ -n "$$unformatted" ]; then echo "gofmt needed:"; echo "$$unformatted"; exit 1; fi
	go vet ./...
	go test -race -timeout 15m ./...

web-test:
	cd web && npm ci && npm run typecheck && npm test

deploy-test:
	deploy/auto-deploy_test.sh

build: embed
	CGO_ENABLED=0 go build -trimpath -ldflags "$(LDFLAGS)" -o bin/mealquest ./cmd/server

web:
	cd web && npm ci && npm run build

# Replace the committed placeholder with the built PWA so go:embed picks it up.
# Recreate the whole directory: a glob would skip dotfiles, which all:dist embeds.
embed: web
	rm -rf $(FRONTEND_DIST)
	mkdir -p $(FRONTEND_DIST)
	cp -R web/dist/. $(FRONTEND_DIST)/

# Regression check: a stale hidden file must not survive an embed.
check-embed-clean:
	touch $(FRONTEND_DIST)/.stale-embed-check
	$(MAKE) embed
	test ! -e $(FRONTEND_DIST)/.stale-embed-check

docker:
	docker build --build-arg VERSION=$(VERSION) -t $(IMAGE) .

# sqlc $(SQLC_VERSION) needs Go 1.26 to build; GOTOOLCHAIN=auto lets go fetch
# it for this install only, even where the environment pins the local Go.
sqlc-install:
	GOTOOLCHAIN=auto go install github.com/sqlc-dev/sqlc/cmd/sqlc@$(SQLC_VERSION)

# Previously generated files are removed first so a dropped query file does
# not leave its stale output behind; hand-written files are kept.
sqlc:
	@v="$$($(SQLC) version)"; \
	if [ "$$v" != "$(SQLC_VERSION)" ]; then echo "sqlc $(SQLC_VERSION) required, $(SQLC) is $$v"; exit 1; fi
	find $(SQLC_OUT) -maxdepth 1 -name '*.go' -exec grep -l -x '// Code generated by sqlc. DO NOT EDIT.' {} + | xargs -r rm --
	$(SQLC) generate

# Fails on any difference from the committed generated code, including new
# or deleted files. A failing git status is itself a failure: its empty
# output would otherwise read as "no drift".
sqlc-check: sqlc
	@drift="$$(git status --porcelain --untracked-files=all -- $(SQLC_OUT))" || { echo "git status failed; cannot check internal/db for drift"; exit 1; }; \
	if [ -n "$$drift" ]; then echo "internal/db is stale; run make sqlc and commit:"; echo "$$drift"; git diff -- $(SQLC_OUT); exit 1; fi
