# Owns the MealQuest compose stack (deploy/compose.yaml). The services use
# restart: "no", so Docker never starts them on its own; this unit is the
# only start path.
#
# Requires= and After=mealquest-firewall.service start the stack only after
# the DOCKER-USER rules are applied, and not at all if that unit fails.
# PartOf=docker.service propagates a Docker stop or restart here, so a
# Docker restart re-applies the firewall before the stack comes back.
#
# Restart=on-failure re-runs this unit when ExecStart exits non-zero or
# times out, so a Docker restart that races a same-host dependency (OIDC
# discovery HTTP 503) comes back with no operator. systemctl stop is not
# a failure, so a stack stopped on purpose stays stopped.
#
# The retry budget is a total bound, not a rate window. systemd 259
# ratelimit_below opens a new window only when (now - begin) >
# StartLimitIntervalSec. infinity never does, so StartLimitBurst=20 is the
# total number of start attempts until the counter is cleared. Becoming
# active does not clear it; only unit_reset_failed does. ExecStartPost runs
# `systemctl reset-failed` after ExecStart exits 0. The command has no "-"
# prefix, so a non-zero reset-failed fails the unit instead of leaving it
# active with a consumed counter. systemd then skips ExecStop= (the
# failure is before the service is fully up) and Restart=on-failure
# retries. The failed reset did not clear the counter, and infinity never
# opens a new window, so those retries stay inside StartLimitBurst and
# cannot loop without a bound. A reset that exits 0 is what gives a
# recovered stack and an ordinary restart a fresh budget. A failed
# ExecStart does not run ExecStartPost, so a failure streak consumes the
# budget. The next start is refused, the unit stays failed, and the
# journal records "Start request repeated too quickly." Nothing schedules
# another restart after that.
#
# Type=oneshot leaves TimeoutStartSec unset, which means infinity. Setting
# it makes systemd kill ExecStart and record timeout, which
# Restart=on-failure retries. TimeoutStopSec is the SIGTERM grace after
# that kill; a process that exits on its own does not consume it. Worst
# case, every attempt burns both timeouts: 20*(300+90+15)=8100s. Quick
# failures, where ExecStart returns immediately, reach the refusal in
# 20*15s=300s.
#
# mealquest-auto-deploy.service keeps its ExecCondition
# (systemctl is-active --quiet mealquest.service). Auto-deploy does not
# start or redeploy an operator-stopped stack, and a stack that has
# exhausted this budget stays failed for an operator.
[Unit]
Description=MealQuest compose stack
Requires=mealquest-firewall.service
After=mealquest-firewall.service docker.service
PartOf=docker.service
StartLimitIntervalSec=infinity
StartLimitBurst=20

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s
TimeoutStartSec=300s
TimeoutStopSec=90s
ExecStart=/usr/bin/docker compose -f /home/overseer/mealquest/deploy/compose.yaml up -d
ExecStartPost=/usr/bin/systemctl reset-failed mealquest.service
ExecStop=/usr/bin/docker compose -f /home/overseer/mealquest/deploy/compose.yaml down

[Install]
WantedBy=multi-user.target
