## Output contract
This contract overrides any earlier instruction about the form of your reply. Reply with one JSON value matching the JSON Schema "quick_ideas" below, and nothing else: no prose and no Markdown code fences.

{
  "type": "object",
  "properties": {
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "est_minutes": {
            "type": "integer"
          },
          "method": {
            "type": "string",
            "enum": [
              "stovetop",
              "oven",
              "crockpot",
              "grill",
              "other"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "search_query": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "est_minutes",
          "method",
          "difficulty",
          "search_query"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ideas"
  ],
